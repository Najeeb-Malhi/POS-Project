tk.Button(btn,text="Add to Cart",command=add_to_cart_ui,width=18,height=2).grid(row=0,column=3,padx=5)
tk.Button(btn,text="Remove From Cart",command=remove_from_cart_ui,width=18,height=2).grid(row=1, column=3, padx=5)
